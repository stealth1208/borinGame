# Copy to .env.local

# Public site URL used in links (optional; the QR uses the current browser origin)
NEXT_PUBLIC_APP_URL=http://localhost:43123

# Leave empty to run the in-memory store (good for local demo).
# Fill both to persist rooms in Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
